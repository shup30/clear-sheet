{
  "name": "clear-sheet-viewer",
  "version": "1.0.1",
  "description": "Lightweight Excel and CSV editor for Windows",
  "author": "Clear Sheet",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "start": "npm run build && electron .",
    "test": "npm run build && node tests/integrity.cjs && node tests/smoke.cjs && node tests/editor.cjs && node tests/interactions.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --config.electronDist=node_modules/electron/dist",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc -p tsconfig.electron.json --noEmit --noUnusedLocals --noUnusedParameters",
    "test:integrity": "node tests/integrity.cjs",
    "test:interactions": "node tests/interactions.cjs",
    "test:packaged": "node tests/packaged.cjs && node tests/interactions.cjs --packaged"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@mui/material": "^7.3.0",
    "ag-grid-community": "^34.3.0",
    "ag-grid-react": "^34.3.0",
    "lucide-react": "^1.51.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "picocolors": "^1.1.1",
    "playwright": "^1.55.0",
    "postcss": "^8.5.28",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.clearsheet.viewer",
    "productName": "Clear Sheet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "fileAssociations": [
      {
        "ext": [
          "xlsx",
          "xls",
          "xlsm",
          "xlsb",
          "csv"
        ],
        "name": "Spreadsheet",
        "role": "Editor"
      }
    ]
  }
}
